                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/sales-pages": {
            "get": {
                "tags": [
                    "Sales Pages"
                ],
                "summary": "List all sales pages for authenticated user",
                "operationId": "1f260d03be4b008083c9cde0b01bd37a",
                "parameters": [
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 10
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Sales pages retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Sales pages retrieved successfully."
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/SalesPageResource"
                                            }
                                        },
                                        "meta": {
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer"
                                                },
                                                "last_page": {
                                                    "type": "integer"
                                                },
                                                "per_page": {
                                                    "type": "integer"
                                                },
                                                "total": {
                                                    "type": "integer"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/sales-pages/generate": {
            "post": {
                "tags": [
                    "Sales Pages"
                ],
                "summary": "Generate a new AI sales page",
                "operationId": "ce5b2f7ec326a959229a5989fc04c4f8",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "product_name",
                                    "description",
                                    "key_features",
                                    "target_audience",
                                    "price",
                                    "unique_selling_points"
                                ],
                                "properties": {
                                    "product_name": {
                                        "type": "string",
                                        "maxLength": 255,
                                        "minLength": 2,
                                        "example": "My Product"
                                    },
                                    "description": {
                                        "type": "string",
                                        "maxLength": 2000,
                                        "minLength": 10,
                                        "example": "A great product that solves problems."
                                    },
                                    "key_features": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "maxItems": 10,
                                        "minItems": 1,
                                        "example": [
                                            "Fast",
                                            "Reliable",
                                            "Affordable"
                                        ]
                                    },
                                    "target_audience": {
                                        "type": "string",
                                        "maxLength": 500,
                                        "minLength": 5,
                                        "example": "Small business owners"
                                    },
                                    "price": {
                                        "type": "string",
                                        "maxLength": 100,
                                        "example": "$99/month"
                                    },
                                    "unique_selling_points": {
                                        "type": "string",
                                        "maxLength": 1000,
                                        "minLength": 10,
                                        "example": "The only tool that does X and Y."
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Sales page generated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Sales page generated successfully."
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/SalesPageResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "429": {
                        "description": "Too many requests"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
